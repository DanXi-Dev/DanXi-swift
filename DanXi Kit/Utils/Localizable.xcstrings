  "strings" : {
    "Connection interrupted. Refresh the conversation before sending again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已中断，请先刷新对话再决定是否重新发送。"
          }
        }
      }
    },
    "Danta Intelligence Error" : {
      "localizations" : {
