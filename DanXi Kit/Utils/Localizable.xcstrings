          }
        }
      }
    },
    "Token has expired, please login again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旦挞账户登录凭据失效，请重新登录。"
          }
        }
      }
    },
    "Token not found." : {
      "localizations" : {
