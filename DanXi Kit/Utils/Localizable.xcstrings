            "value" : "暂时无法连接旦挞智能服务。"
          }
        }
      }
    },
    "Danta Intelligence could not complete the request. Please try again later." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旦挞智能暂时无法完成请求，请稍后重试。"
          }
        }
      }
    },
    "Error %@: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
