          }
        }
      }
    },
    "VPN Error" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your requests are too frequent, please try again later. If this problem persists, please disable the automatic proxy in the settings of this App and access it under the campus network environment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的请求过于频繁，请稍后再试。如果此问题持续出现，请在本App设置中关闭自动代理后在校园网环境下访问。\n"
          }
        }
      }
    },
    "You do not have permission to perform this operation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你没有执行此操作的权限。"
          }
        }
      }
    },
    "Your OpenClaw instance is not ready." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 OpenClaw 实例尚未就绪。"
          }
        }
      }
