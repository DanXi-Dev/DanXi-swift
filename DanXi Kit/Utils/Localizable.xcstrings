          "stringUnit" : {
            "state" : "translated",
            "value" : "错误%1$@：%2$@"
          }
        }
      }
    },
    "No reply was received. Refresh the conversation before sending again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未收到回复，请先刷新对话再决定是否重新发送。"
          }
        }
      }
    },
    "Please sign in again to use Danta Intelligence." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新登录后使用旦挞智能。"
          }
        }
      }
    },
    "The Danta Intelligence request timed out." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旦挞智能请求超时。"
          }
        }
      }
    },
    "The request identifier cannot be empty." : {
      "localizations" : {
